# Versão simples para desenvolvimento
FROM node:22-alpine

WORKDIR /app

# Copia os arquivos de manifesto de pacotes
COPY package*.json ./

# Instala todas as dependências (dev + prod)
RUN npm ci

# Copia o restante do código
COPY . .

# Expõe a porta
EXPOSE 2705

# Comando para desenvolvimento
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]